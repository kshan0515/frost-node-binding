{
  "name": "@kshan0515/frost-node-binding",
  "version": "0.2.2",
  "description": "Node.js native binding for FROST Ed25519 MPC protocol - Distributed key generation and threshold signing",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/kshan0515/frost-node-binding"
  },
  "keywords": [
    "mpc",
    "eddsa",
    "ed25519",
    "frost",
    "threshold-signature",
    "dkg",
    "signing",
    "cryptography",
    "napi",
    "native"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "frost-node-binding",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "postbuild": "node -e \"require('fs').copyFileSync('index.d.copy.ts', 'index.d.ts')\"",
    "postbuild:debug": "node -e \"require('fs').copyFileSync('index.d.copy.ts', 'index.d.ts')\"",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "jest",
    "universal": "napi universal",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0-alpha.60",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ]
}
